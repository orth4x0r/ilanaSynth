+// A factory preset's tags ("Bell, FM, Bright"), or "" for any other name.
+inline juce::String factoryTags (const juce::String& name)
+{
+    static const auto table = []
+    {
+        std::map<juce::String, const char*> map;
+
+        for (const auto& row : factoryTagRows)
+            map.emplace (juce::String::fromUTF8 (row.name), row.tags);
+
+        return map;
+    }();
+
+    const auto found = table.find (name);
+    return found != table.end() ? juce::String (found->second) : juce::String();
+}
