// "Append only" as a check: the parameters, mod destinations and mod sources
// as text, compared with the committed tests/param-manifest.txt. A saved
// state names parameters by ID and choices and mod routes by index, so:
//   parameters:   an ID may not disappear; its type, range and default stay;
//                 a choice list may only grow at the end (compared by ID, not
//                 by position, since layout code may add a parameter mid-list)
//   destinations, sources: index -> name never changes; new ones go on the end
// Included by TableTest.cpp; ILANA_TEST_ONLY=manifest runs only this.
// ILANA_WRITE_MANIFEST=1 (or no committed file) writes the file instead; do
// that only for an intended addition, and commit the result.

namespace ManifestLab
{
struct Manifest
{
    juce::StringArray parameters, destinations, sources;
};

inline juce::String number (float value)
{
    return juce::String ((double) value, 6);
}

inline Manifest build (IlanaSynthAudioProcessor& processor)
{
    Manifest manifest;

    for (auto* parameter : processor.getParameters())
    {
        auto* ranged = dynamic_cast<juce::RangedAudioParameter*> (parameter);
        if (ranged == nullptr)
        {
            manifest.parameters.add ("?" + juce::String (parameter->getName (64)) + "|other");
            continue;
        }

        const auto range = ranged->getNormalisableRange();
        const auto defaultValue = ranged->convertFrom0to1 (ranged->getDefaultValue());
        juce::String type = "float", choices;

        if (dynamic_cast<juce::AudioParameterBool*> (ranged) != nullptr)
            type = "bool";
        else if (auto* choice = dynamic_cast<juce::AudioParameterChoice*> (ranged))
        {
            type = "choice";
            choices = choice->choices.joinIntoString ("|");
        }
        else if (dynamic_cast<juce::AudioParameterInt*> (ranged) != nullptr)
            type = "int";

        // ID ; type ; min ; max ; default ; choices (a choice's max is its last index)
        manifest.parameters.add (ranged->getParameterID() + ";" + type + ";" + number (range.start) + ";" + number (range.end)
                                 + ";" + number (defaultValue) + ";" + choices);
    }

    // Destination index -> the parameter's ID for a parameter destination, else the name.
    const auto names = Mod::getDestinationNames();
    for (int i = 0; i < names.size(); ++i)
    {
        const auto entry = Mod::paramDestinationIndex (i);
        manifest.destinations.add (juce::String (i) + " " + (entry >= 0 ? juce::String (Mod::getParamDestinations()[(size_t) entry].id) : names[i]));
    }

    const auto sources = Mod::getSourceNames();
    for (int i = 0; i < sources.size(); ++i)
        manifest.sources.add (juce::String (i) + " " + sources[i]);

    return manifest;
}

inline juce::String toText (const Manifest& manifest)
{
    juce::String text;
    text << "# Generated by ILANA_WRITE_MANIFEST=1 ilanaTableTest (ILANA_TEST_ONLY=manifest). Append only:\n"
         << "# nothing here may disappear or change; see tests/ParamManifestTests.inc.\n";
    const auto section = [&text] (const char* title, const juce::StringArray& lines)
    {
        text << "[" << title << "]\n";
        for (const auto& line : lines)
            text << line << "\n";
    };
    section ("parameters", manifest.parameters);
    section ("destinations", manifest.destinations);
    section ("sources", manifest.sources);
    return text;
}

inline Manifest parse (const juce::String& text)
{
    Manifest manifest;
    juce::StringArray* current = nullptr;

    for (auto line : juce::StringArray::fromLines (text))
    {
        line = line.trimEnd();
        if (line.isEmpty() || line.startsWithChar ('#'))
            continue;
        if (line == "[parameters]")
            current = &manifest.parameters;
        else if (line == "[destinations]")
            current = &manifest.destinations;
        else if (line == "[sources]")
            current = &manifest.sources;
        else if (current != nullptr)
            current->add (line);
    }

    return manifest;
}

inline juce::String idOf (const juce::String& line)
{
    return line.upToFirstOccurrenceOf (";", false, false);
}

// Compares by index: every old line must be the same in the new list.
inline void compareByIndex (const char* what, const juce::StringArray& old, const juce::StringArray& now)
{
    auto bad = 0;
    for (int i = 0; i < old.size(); ++i)
    {
        if (i >= now.size())
        {
            check (false, juce::String ("manifest: ") + what + " line " + juce::String (i) + " \"" + old[i] + "\" is gone");
            ++bad;
        }
        else if (now[i] != old[i])
        {
            check (false, juce::String ("manifest: ") + what + " line " + juce::String (i) + " changed from \"" + old[i] + "\" to \"" + now[i] + "\"");
            ++bad;
        }
    }
    check (bad == 0, juce::String ("manifest: ") + what + " keep their index (" + juce::String (old.size()) + " committed, " + juce::String (now.size()) + " now)");
}

// Compares by parameter ID: an old ID stays, with the same type, range and default;
// a choice list keeps its old entries first.
inline void compareParameters (const juce::StringArray& old, const juce::StringArray& now)
{
    std::map<juce::String, juce::String> byId;
    for (const auto& line : now)
        byId[idOf (line)] = line;

    auto bad = 0;
    for (const auto& oldLine : old)
    {
        const auto id = idOf (oldLine);
        const auto found = byId.find (id);
        if (found == byId.end())
        {
            check (false, "manifest: parameter \"" + id + "\" is gone");
            ++bad;
            continue;
        }

        if (found->second == oldLine)
            continue;

        // Fields: id, type, min, max, default, choices (empty ones kept).
        const auto split = [] (const juce::String& line)
        {
            juce::StringArray fields;
            auto rest = line;
            for (int k = 0; k < 5; ++k)
            {
                fields.add (rest.upToFirstOccurrenceOf (";", false, false));
                rest = rest.fromFirstOccurrenceOf (";", false, false);
            }
            fields.add (rest);
            return fields;
        };
        const auto o = split (oldLine), n = split (found->second);
        auto ok = o[1] == n[1] && o[4] == n[4];

        if (o[1] == "choice")
        {
            const auto oldChoices = juce::StringArray::fromTokens (o[5], "|", "");
            const auto newChoices = juce::StringArray::fromTokens (n[5], "|", "");
            auto prefix = newChoices.size() >= oldChoices.size() && o[2] == n[2];
            for (int k = 0; prefix && k < oldChoices.size(); ++k)
                prefix = oldChoices[k] == newChoices[k];
            ok = ok && prefix;
        }
        else
            ok = ok && o[2] == n[2] && o[3] == n[3];

        if (! ok)
        {
            check (false, "manifest: parameter \"" + id + "\" changed in place: was \"" + oldLine + "\", now \"" + found->second + "\"");
            ++bad;
        }
    }
    check (bad == 0, "manifest: every committed parameter keeps its ID, type, range, default and choices ("
                         + juce::String (old.size()) + " committed, " + juce::String (now.size()) + " now)");
}
} // namespace ManifestLab

void runParamManifestTests()
{
    IlanaSynthAudioProcessor processor;
    const auto now = ManifestLab::build (processor);
    check (now.parameters.size() > 100 && now.destinations.size() > 100 && now.sources.size() > 20,
           "manifest: built (" + juce::String (now.parameters.size()) + " parameters, " + juce::String (now.destinations.size())
               + " destinations, " + juce::String (now.sources.size()) + " sources)");

    const auto file = juce::File (ILANA_SOURCE_DIR).getChildFile ("tests/param-manifest.txt");
    const auto write = juce::SystemStats::getEnvironmentVariable ("ILANA_WRITE_MANIFEST", "").isNotEmpty();

    if (write || ! file.existsAsFile())
    {
        const auto ok = file.replaceWithText (ManifestLab::toText (now));
        check (ok, "manifest: wrote " + file.getFullPathName() + (write ? "" : " (it was missing; commit it)"));
        return;
    }

    const auto old = ManifestLab::parse (file.loadFileAsString());
    ManifestLab::compareParameters (old.parameters, now.parameters);
    ManifestLab::compareByIndex ("destinations", old.destinations, now.destinations);
    ManifestLab::compareByIndex ("sources", old.sources, now.sources);

    // New entries are fine, but say so: the file wants regenerating.
    if (now.parameters.size() > old.parameters.size() || now.destinations.size() > old.destinations.size()
        || now.sources.size() > old.sources.size())
        std::cout << "NOTE: the manifest has additions; regenerate with ILANA_WRITE_MANIFEST=1 ilanaTableTest and commit tests/param-manifest.txt" << std::endl;
}
